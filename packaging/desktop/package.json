{
  "name": "eir",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "fr.boxingcenter.eir",
    "productName": "EIR",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "EIR.exe"
    }
  }
}
